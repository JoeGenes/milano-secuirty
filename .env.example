# Milano Security - Environment Variables Configuration

# Server Port (Default: 3001)
PORT=3001

# ==========================================
# SMTP Mail Server Configuration
# ==========================================

# SMTP Hostname
# Examples:
#   Gmail: smtp.gmail.com
#   Hostinger / cPanel: mail.milanosecurity.co.tz (or mail.yourdomain.com)
#   Outlook / Office365: smtp.office365.com
#   SendGrid: smtp.sendgrid.net
SMTP_HOST=smtp.gmail.com

# SMTP Port
# Port 465 = SSL/TLS (SMTP_SECURE=true)
# Port 587 = STARTTLS (SMTP_SECURE=false)
SMTP_PORT=465

# SMTP Secure Flag ('true' for port 465, 'false' for port 587/25)
SMTP_SECURE=true

# SMTP Authentication Credentials
SMTP_USER=careers@milanosecurity.co.tz
SMTP_PASS=your-app-password-or-smtp-password

# Dedicated From Email Address (Must match authenticated user address for Gmail/SendGrid)
SMTP_FROM=Milano Security <careers@milanosecurity.co.tz>

# Ignore self-signed or domain alias SSL certificate errors ('false' allows custom/cPanel certs)
SMTP_REJECT_UNAUTHORIZED=false

# ==========================================
# Recipient Inboxes
# ==========================================
RECEIVER_EMAIL=careers@milanosecurity.co.tz
SUPPORT_EMAIL=support@milanosecurity.co.tz
SALES_EMAIL=sales@milanosecurity.co.tz
